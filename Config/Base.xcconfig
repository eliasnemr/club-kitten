// Supabase project settings. Put your real values in Secrets.xcconfig (not committed).
// Leave them empty to play with the offline practice friends.
// Use SUPABASE_PROJECT_REF = local to talk to `supabase start` on this Mac.
SUPABASE_PROJECT_REF =
SUPABASE_ANON_KEY =
// Cloud save turns on with the keys above. Multiplayer (friends, lounges, playdates) is separate.
SUPABASE_MULTIPLAYER = NO

#include? "Secrets.xcconfig"
